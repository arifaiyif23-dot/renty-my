# =============================================================================
# RENTY Environment Variables
# =============================================================================
# Copy this to .env and fill in your values before deploying.
# Supabase env vars (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY)
# are auto-injected by Supabase when deployed as edge functions.
# =============================================================================

# --- Frontend ---
# Your production frontend URL (e.g. https://renty.my)
FRONTEND_URL=https://renty.my

# Supabase project URL (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable/anon key (NOT the service_role key — never expose that client-side)
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGci...

# Web Push VAPID public key (Supabase Dashboard → Project Settings → VAPID Keys)
# Used by src/hooks/use-push-notifications.tsx for browser push notifications
VITE_VAPID_PUBLIC_KEY=

# Site URL used for auth email redirects (MUST be set to the production web origin,
# NOT the app scheme — Capacitor will use this for magic link / password reset URLs)
VITE_SITE_URL=https://renty.my

# --- Auth ---
# Magic link uses Supabase built-in email auth (no extra env vars needed).
# For production, configure custom SMTP in Supabase Dashboard:
#   Auth → Settings → SMTP Settings (use Resend SMTP credentials).
# The site URL must be set in Supabase Dashboard for magic link redirect:
#   Auth → Settings → Site URL (e.g. https://renty.my)

# --- ToyyibPay (Payment Gateway) ---
# Get these from your ToyyibPay merchant account dashboard
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=

# --- Resend (Transactional Emails) ---
# Get API key from https://resend.com
RESEND_API_KEY=
# Verified sender domain/email (e.g. no-reply@renty.my)
RESEND_FROM_EMAIL=
# Webhook secret for receiving email delivery events (optional but recommended)
RESEND_WEBHOOK_SECRET=

# --- eKYC Providers (pick one) ---

# Option A: Shufti Pro (free tier: 10 verifications/month)
# https://shuftipro.com
SHUFTIPRO_CLIENT_ID=
SHUFTIPRO_SECRET_KEY=

# Option B: iDenfy
# https://idenfy.com
IDENFY_API_KEY=
IDENFY_API_SECRET=

# Option C: Veriff
# https://veriff.com
VERIFF_API_KEY=
VERIFF_API_SECRET=

# Option D: Kenal.io (Malaysian, cheapest ~RM1/verification)
# https://kenal.io
KENAL_API_KEY=

# --- Workflow Automation (optional) ---
# n8n webhook URL for receipt generation workflow
N8N_RECEIPT_WEBHOOK_URL=

# --- Admin ---
# Admin email for notifications (seeded in app.admin_email config)
ADMIN_EMAIL=admin@your-domain.com

# --- Push Notifications (FCM native) ---
# Firebase Cloud Messaging for the Capacitor mobile app.
# 1. Create a Firebase project and add the Android/iOS app (applicationId com.renty.app).
# 2. Download the service account JSON (Project settings -> Service accounts -> Firebase Admin SDK)
#    from the Firebase console and paste its full JSON content here.
FCM_SERVICE_JSON=
# Your Firebase project id (visible in Firebase console project settings).
FCM_PROJECT_ID=
# Web push public VAPID key (for PWA browser push). Generate a VAPID keypair
# (e.g. via `npx web-push generate-vapid-keys`) and put the PUBLIC key here.
VITE_VAPID_PUBLIC_KEY=
# Used by the DB->function webhook (send-push-notification). Must match a
# value stored as Postgres setting `webhook.secret` for the trigger to dispatch.
WEBHOOK_SECRET=
# Required by scheduled maintenance functions (cleanup-expired-payments,
# process-rental-transitions). The scheduler must send it as `x-cron-secret`.
CRON_SECRET=

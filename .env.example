# =============================================================================
# RENTY Environment Variables
# =============================================================================
# Copy this to .env and fill in your values before deploying.
# Supabase env vars (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY)
# are auto-injected by Supabase when deployed as edge functions.
# =============================================================================

# --- Frontend ---
# Your production frontend URL (e.g. https://renty.my)
FRONTEND_URL=https://renty.my

# --- ToyyibPay (Payment Gateway) ---
# Get these from your ToyyibPay merchant account dashboard
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=

# --- Resend (Transactional Emails) ---
# Get API key from https://resend.com
RESEND_API_KEY=
# Verified sender domain/email (e.g. no-reply@renty.my)
RESEND_FROM_EMAIL=
# Webhook secret for receiving email delivery events (optional but recommended)
RESEND_WEBHOOK_SECRET=

# --- eKYC Providers (pick one) ---

# Option A: Shufti Pro (free tier: 10 verifications/month)
# https://shuftipro.com
SHUFTIPRO_CLIENT_ID=
SHUFTIPRO_SECRET_KEY=

# Option B: iDenfy
# https://idenfy.com
IDENFY_API_KEY=
IDENFY_API_SECRET=

# Option C: Veriff
# https://veriff.com
VERIFF_API_KEY=
VERIFF_API_SECRET=

# Option D: Kenal.io (Malaysian, cheapest ~RM1/verification)
# https://kenal.io
KENAL_API_KEY=

# --- Workflow Automation (optional) ---
# n8n webhook URL for receipt generation workflow
N8N_RECEIPT_WEBHOOK_URL=

# --- Admin ---
# Admin email for notifications (seeded in app.admin_email config)
ADMIN_EMAIL=arifaiyif03@gmail.com

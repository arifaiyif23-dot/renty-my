    "build:apk": "npm run build && npx cap sync android && cd android && gradlew assembleDebug",
    "icons:generate-types": "node scripts/generate-icon-types.mjs",
    "icons:list": "node scripts/generate-icon-types.mjs && type src\\lib\\icons\\generated.ts | findstr /i \"AVAILABLE_ICONS\""
